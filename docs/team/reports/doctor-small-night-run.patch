--- a/profile/airootfs/usr/local/bin/sunshine-doctor
+++ b/profile/airootfs/usr/local/bin/sunshine-doctor
@@ -33,8 +33,9 @@
 if out=$(pacman -Dk 2>&1); then ok "package database consistent"; else bad "package database problem: $(echo "$out" | head -2 | tr '\n' ' ')"; fi
 for r in $(pacman-conf --repo-list 2>/dev/null); do
   db=/var/lib/pacman/sync/$r.db
-  if [ ! -s "$db" ]; then dbs_bad="$dbs_bad $r"; elif ! bsdtar -tf "$db" >/dev/null 2>&1; then dbs_bad="$dbs_bad $r"; rm -f "$db"; fi
+  if [ ! -s "$db" ]; then dbs_bad="$dbs_bad $r"; elif ! bsdtar -tf "$db" >/dev/null 2>&1; then dbs_bad="$dbs_bad $r"; [ $FIX = 1 ] && curl -fsI --max-time 6 https://archlinux.org >/dev/null 2>&1 && rm -f "$db"; fi   # only with --fix and only when it can be downloaded again
 done
+for r in core extra; do grep -q "^\[$r\]" /etc/pacman.conf 2>/dev/null || bad "pacman.conf does not list the [$r] repository"; done
 if [ -n "${dbs_bad:-}" ]; then warn "package databases missing or damaged:$dbs_bad"; [ $FIX = 1 ] && pacman -Sy >/dev/null 2>&1 && fx "package databases downloaded again"; else ok "package databases are intact"; fi
 # a partial upgrade (pacman -Sy, then installing something, without -u) is the classic way to break Arch
 if [ -r /var/log/pacman.log ] && awk '/synchronizing package lists/{sync=1} /starting full system upgrade/{sync=0} /\[ALPM\] (installed|upgraded) /{ if (sync) bad=1 } END{exit !bad}' /var/log/pacman.log; then
@@ -146,7 +147,14 @@
 fu=$(systemctl --failed --no-legend 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
 [ -z "${fu// }" ] && ok "no failed services" || warn "failed services: $fu"
 use=$(df --output=pcent / | tail -1 | tr -dc 0-9)
-if [ "${use:-0}" -ge 95 ]; then bad "root disk ${use}% full"; elif [ "${use:-0}" -ge 85 ]; then warn "root disk ${use}% full"; else ok "root disk ${use}% used"; fi
+if [ "${use:-0}" -ge 95 ]; then bad "root disk ${use}% full"
+  if [ $FIX = 1 ]; then
+    before=$(df --output=avail -B1 / | tail -1 | tr -dc 0-9)
+    paccache -rk1 >/dev/null 2>&1; journalctl --vacuum-size=200M >/dev/null 2>&1
+    after=$(df --output=avail -B1 / | tail -1 | tr -dc 0-9); freed=$(( (after - before) / 1048576 )); [ "$freed" -lt 0 ] && freed=0
+    fx "freed $freed MB (old package files and journal)"
+  fi
+elif [ "${use:-0}" -ge 85 ]; then warn "root disk ${use}% full"; else ok "root disk ${use}% used"; fi
 [ "$(systemctl is-active NetworkManager 2>/dev/null)" = active ] && ok "network service running" || warn "NetworkManager is not running"
 [ -d "/usr/lib/modules/$(uname -r)" ] && ok "running kernel matches installed modules" || warn "kernel was updated: restart to use it"
 
