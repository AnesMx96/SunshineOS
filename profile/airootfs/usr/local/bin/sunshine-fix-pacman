#!/usr/bin/env bash
# Repairs the package manager and the AUR helper. Steps taken from what Garuda (garuda-update, garuda-health) and EndeavourOS
# (eos-update, reflector-simple, eos-rankmirrors) do, adapted: stale lock, keyring reset, mirror ranking with fallbacks, broken or
# partial databases, interrupted transactions, corrupt cached packages, pacman.conf sanity, the Sunshine repository, the AUR helper.
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
[ -r /usr/local/lib/sunshine/ui.sh ] && . /usr/local/lib/sunshine/ui.sh || { sec() { echo "* $*"; }; ok() { echo "+ $*"; }; bad() { echo "x $*"; }; t() { printf '%s' "${2:-$1}"; }; tr() { printf '%s' "$*"; }; Y=; G=; R=; B=; N=; }
sec "$(t repair_lock 'Lock file')"
if [ -e /var/lib/pacman/db.lck ]; then
  if pgrep -x pacman >/dev/null; then bad "pacman is running right now; close it first."; exit 1; fi
  rm -f /var/lib/pacman/db.lck && ok "stale lock removed"
else ok "no lock"; fi
sec "pacman.conf"
grep -q '^\[core\]' /etc/pacman.conf && grep -q '^\[extra\]' /etc/pacman.conf || { bad "core/extra missing: restoring the packaged pacman.conf"; [ -f /etc/pacman.conf.pacnew ] && cp /etc/pacman.conf /etc/pacman.conf.broken && cp /etc/pacman.conf.pacnew /etc/pacman.conf; }
grep -q '^ParallelDownloads' /etc/pacman.conf || sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf
sec "$(t repair_keyring 'Keyring')"           # garuda-update: reset the keyring when signatures fail
if ! pacman-key --list-keys >/dev/null 2>&1 || [ "${1:-}" = --reset-keys ] || pacman -Sy 2>&1 | grep -qi -E "signature|unknown trust|keyring"; then
  rm -rf /etc/pacman.d/gnupg; pacman-key --init >/dev/null 2>&1; pacman-key --populate >/dev/null 2>&1 && ok "keyring recreated and populated"
else pacman-key --populate >/dev/null 2>&1; ok "keyring populated"; fi
sec "$(t repair_mirrors 'Mirrors')"            # eos-rankmirrors / reflector-simple: rank, keep a backup, fall back to the old list
cp -n /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.sunshine-backup
if command -v rate-mirrors >/dev/null; then rate-mirrors --save=/etc/pacman.d/mirrorlist.new arch >/dev/null 2>&1 && [ -s /etc/pacman.d/mirrorlist.new ] && mv /etc/pacman.d/mirrorlist.new /etc/pacman.d/mirrorlist && ok "mirrors ranked (rate-mirrors)"
elif command -v reflector >/dev/null; then reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist.new >/dev/null 2>&1 && [ -s /etc/pacman.d/mirrorlist.new ] && mv /etc/pacman.d/mirrorlist.new /etc/pacman.d/mirrorlist && ok "mirrors ranked (reflector)" || bad "ranking failed: keeping the current list"
else echo "$(tr "no mirror ranking tool installed: keeping the current list")"; fi
grep -q '^Server' /etc/pacman.d/mirrorlist || { cp /etc/pacman.d/mirrorlist.sunshine-backup /etc/pacman.d/mirrorlist; echo "Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch" >> /etc/pacman.d/mirrorlist; bad "no usable mirror: added the Arch geo mirror"; }
sec "Sunshine repository"; /usr/local/bin/sunshine-repo ensure
sec "Databases"                                   # damaged sync databases are removed so they download again
for db in /var/lib/pacman/sync/*.db; do [ -f "$db" ] && ! bsdtar -tf "$db" >/dev/null 2>&1 && { rm -f "$db"; echo "removed damaged $(basename "$db")"; }; done
pacman -Syy --noconfirm 2>&1 | tail -3
sec "Interrupted updates and cached packages"      # a failed transaction leaves partial downloads and bad cache files
find /var/cache/pacman/pkg -name '*.part' -delete 2>/dev/null; find /var/cache/pacman/pkg -name 'download-*' -prune -exec rm -rf {} + 2>/dev/null
for p in /var/cache/pacman/pkg/*.pkg.tar.zst; do [ -f "$p" ] && ! zstd -tq "$p" 2>/dev/null && { rm -f "$p" "$p.sig"; echo "removed corrupt $(basename "$p")"; }; done
pacman -S --needed --noconfirm archlinux-keyring 2>&1 | tail -2
pacman -Dk 2>&1 | tail -3 && ok "package database checked"
sec "AUR helper"                                   # paru / yay: dependencies and cache
for h in paru yay; do
  command -v "$h" >/dev/null || continue
  if ! "$h" --version >/dev/null 2>&1; then bad "$h does not start (broken libalpm?): reinstalling"; pacman -S --noconfirm --needed "$h" 2>&1 | tail -1 || pacman -S --noconfirm "$h-bin" 2>&1 | tail -1; else ok "$h works ($("$h" --version | head -1))"; fi
done
command -v paru >/dev/null || command -v yay >/dev/null || echo "$(tr "no AUR helper installed (paru-bin is in the [sunshine] repository: sudo pacman -S paru-bin)")"
for u in $(getent passwd | awk -F: '$3>=1000 && $3<60000 {print $6}'); do [ -d "$u/.cache/paru" ] && find "$u/.cache/paru" -maxdepth 3 -name '.git' -prune -o -type d -name pkg -prune -exec true \; 2>/dev/null; done
printf '\n%s\n' "$(t repair_done 'Done. Try the update again.')"
