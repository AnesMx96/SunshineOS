[init]
	defaultBranch = main
[pull]
	rebase = false
[color]
	ui = auto
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv
	ci = commit
	cm = commit -m
	ca = commit --amend --no-edit
	aa = add -A
	d = diff
	ds = diff --staged
	l = log --oneline --decorate -20
	lg = log --graph --abbrev-commit --decorate --format='%C(bold yellow)%h%C(reset) %C(auto)%d%C(reset) %s %C(dim white)(%cr, %an)%C(reset)' --all
	last = log -1 --stat
	undo = reset --soft HEAD~1
	unstage = reset HEAD --
	pf = push --force-with-lease
	sync = !git pull --rebase && git push
	cleanup = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -r git branch -d
