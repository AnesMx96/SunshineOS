===== /usr/local/bin/sunshine-apps --help =====
# Finishes app installs from the Sunshine catalogue. Choosing an app (installer, store or `sudo pacman -S sunshine-app-<id>`) installs its official
# packages at once and queues the rest here: AUR packages (installed with the AUR helper as your user; third-party binaries are not hosted by us),
# setup scripts (groups, services, firewall ...) and web-app launchers. Anything that needs the internet stays queued until it is online.
#   sunshine-apps pending            what is queued
#   sunshine-apps apply              do the queued work now (root; used at first boot, by a pacman hook, by sunshine-update)
#   sunshine-apps install ID...      install catalogue apps (pacman -S sunshine-app-ID, then apply)
#   sunshine-apps first-update       install the apps marked "first update" in the catalogue (once)
# Log: /var/log/sunshine/apps.log
PEND=/var/lib/sunshine/pending; META=/usr/share/sunshine/apps.d; SETUP=/usr/share/sunshine/apps-setup; LOG=/var/log/sunshine/apps.log
cmd=${1:-pending}; shift || true
[ "$cmd" = pending ] || [ "$(id -u)" -eq 0 ] || exec sudo "$0" "$cmd" "$@"
