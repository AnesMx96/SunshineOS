# Web services as app windows (Outlook, WhatsApp, Netflix, Notion ...): a launcher in the menu that opens the site in its own window
# with its own browser profile, so it feels like an app and does not mix with your normal browsing.
#   sunshine-webapp add ID "Name" URL     create the menu launcher (per user)
#   sunshine-webapp remove ID             remove it
#   sunshine-webapp run ID                open it (what the launcher calls)
#   sunshine-webapp list
# Uses a Chromium-based browser in app mode (chromium, brave, chrome) when there is one, Firefox in a new window otherwise.
set -u
APPS=${XDG_DATA_HOME:-$HOME/.local/share}/applications; DATA=${XDG_DATA_HOME:-$HOME/.local/share}/sunshine/webapps
